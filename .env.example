LOG_LEVEL=INFO
USE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_CONCURRENCY=8
MAX_RETRIES=4
MAX_INPUT_TOKENS=4096
MAX_OUTPUT_TOKENS=1024
PIPELINE_VERSION=obl-pipeline-v1
PROMPT_VERSION=v1.0
PROCESSING_NODE=local-dev
TARGET_OBLIGATION_RATIO=0.50
TARGET_NON_OBLIGATION_RATIO=0.20
TARGET_NEUTRAL_RATIO=0.30
ENABLE_VECTOR_INGEST=true
ENABLE_GRAPH_INGEST=true
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_TYPE=chroma
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=obligation_chunks
GRAPH_DB_TYPE=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
